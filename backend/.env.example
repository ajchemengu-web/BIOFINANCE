# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL — Render Postgres connection string or local instance
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/biofinance

# JWT
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Safaricom Daraja 3.0 sandbox — https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENVIRONMENT=sandbox
# Public HTTPS URL Safaricom posts the STK push result to — sandbox rejects
# localhost, so this needs a tunnel (e.g. ngrok) or the Render deployment URL.
DARAJA_CALLBACK_BASE_URL=

# Comma-separated browser origins allowed to call this API (your Vercel
# deployment URLs, e.g. https://biofinance-mobile.vercel.app). "*" is fine
# for local dev / an early demo.
CORS_ALLOWED_ORIGINS=*
